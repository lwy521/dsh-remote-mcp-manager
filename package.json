{
  "name": "dsh-remote-mcp-manager",
  "version": "0.4.1",
  "icon": "icon.png",
  "description": "DSH 多端 MCP 管理器：手机原生面板 + Web 设置页，配置写在 cordis.patch.yml，保存后由 HMR 自动应用。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-go",
    "mcp",
    "mcp-server",
    "remote-mcp",
    "stdio",
    "streamable-http"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./icon.png": "./icon.png",
    "./icon@2x.png": "./icon@2x.png"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.png",
    "icon@2x.png",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.1.0-rc.6"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dshGo": {
    "v": 1,
    "icon": "plugin",
    "title": {
      "zh": "MCP 管理",
      "en": "MCP Manager"
    },
    "contributes": {
      "panels": [
        {
          "id": "mcp-manager",
          "title": {
            "zh": "MCP 管理",
            "en": "MCP Manager"
          },
          "icon": "plugin",
          "placement": [
            "session.tab",
            "features"
          ]
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lwy521/dsh-remote-mcp-manager.git"
  },
  "dependencies": {
    "js-yaml": "^5.5.0"
  }
}
